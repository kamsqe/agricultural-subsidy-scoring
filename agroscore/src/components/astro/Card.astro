---
interface Props {
  title: string;
  icon?: string;
  color?: 'navy' | 'teal' | 'gold' | 'red' | 'orange' | 'yellow';
}

const { title, icon, color = 'navy' } = Astro.props;

const colorStyles = {
  navy: { bg: 'rgba(30, 58, 95, 0.1)', color: '#1e3a5f', border: '#1e3a5f' },
  teal: { bg: 'rgba(13, 148, 136, 0.1)', color: '#0d9488', border: '#0d9488' },
  gold: { bg: 'rgba(212, 164, 54, 0.1)', color: '#d4a436', border: '#d4a436' },
  red: { bg: 'rgba(220, 38, 38, 0.1)', color: '#dc2626', border: '#dc2626' },
  orange: { bg: 'rgba(217, 119, 6, 0.1)', color: '#d97706', border: '#d97706' },
  yellow: { bg: 'rgba(202, 138, 4, 0.1)', color: '#ca8a04', border: '#ca8a04' }
};

const currentStyle = colorStyles[color] || colorStyles.navy;

const iconPaths: Record<string, string> = {
  'clock': 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
  'repeat': 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  'alert-triangle': 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
  'check-circle': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  'x-circle': 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
  'chart': 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z'
};
---

<div class="bg-white rounded-2xl p-6 border-l-4 transition-all hover:shadow-lg" style={`border-color: ${currentStyle.border}; box-shadow: 0 2px 8px -2px rgba(0,0,0,0.06);`}>
  {icon && (
    <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style={`background: ${currentStyle.bg};`}>
      <svg class="w-6 h-6" style={`color: ${currentStyle.color};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[icon] || iconPaths['chart']} />
      </svg>
    </div>
  )}
  <h3 class="text-lg font-bold mb-2" style="color: #1e3a5f;">{title}</h3>
  <slot />
</div>
