---
interface Props {
  value: string | number;
  label: string;
  description?: string;
  icon?: string;
  trend?: 'positive' | 'negative' | 'warning' | 'neutral';
}

const { value, label, description, icon, trend } = Astro.props;

const trendStyles = {
  positive: { color: '#0d9488', bg: 'rgba(13, 148, 136, 0.1)', border: '#0d9488' },
  negative: { color: '#dc2626', bg: 'rgba(220, 38, 38, 0.1)', border: '#dc2626' },
  warning: { color: '#d97706', bg: 'rgba(217, 119, 6, 0.1)', border: '#d97706' },
  neutral: { color: '#1e3a5f', bg: 'rgba(30, 58, 95, 0.1)', border: '#1e3a5f' }
};

const currentStyle = trend ? trendStyles[trend] : trendStyles.neutral;

const iconPaths: Record<string, string> = {
  'file-text': 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  'x-circle': 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
  'check-circle': 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  'refresh-cw': 'M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15',
  'trending-up': 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6',
  'trending-down': 'M13 17h8m0 0V9m0 8l-8-8-4 4-6-6',
  'users': 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  'dollar': 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z'
};
---

<div class="bg-white rounded-xl p-6 border-l-4 transition-all hover:shadow-md" style={`border-color: ${currentStyle.border}; box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.06);`}>
  <div class="flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <div class="text-3xl font-bold" style={`color: ${currentStyle.color};`}>
        {value}
      </div>
      <div class="text-sm font-semibold mt-1" style="color: #1e3a5f;">
        {label}
      </div>
      {description && (
        <div class="text-xs mt-1" style="color: #627d98;">
          {description}
        </div>
      )}
    </div>
    {icon && (
      <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0" style={`background: ${currentStyle.bg};`}>
        <svg class="w-5 h-5" style={`color: ${currentStyle.color};`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[icon] || iconPaths['file-text']} />
        </svg>
      </div>
    )}
  </div>
</div>
