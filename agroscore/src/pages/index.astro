---
import Layout from '../layouts/Layout.astro';
import Section from '../components/astro/Section.astro';
import Card from '../components/astro/Card.astro';
import MetricCard from '../components/astro/MetricCard.astro';
---

<Layout title="Главная">
  <!-- Hero Section - WOW FACTOR -->
  <section class="relative text-white py-16 lg:py-24 overflow-hidden bg-gradient-animated">
    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-5 bg-grid-pattern"></div>
    
    <!-- Floating Particles -->
    <div class="particles-container">
      <span class="particle"></span>
      <span class="particle"></span>
      <span class="particle"></span>
      <span class="particle"></span>
      <span class="particle"></span>
      <span class="particle particle-teal"></span>
      <span class="particle particle-teal"></span>
      <span class="particle"></span>
      <span class="particle particle-teal"></span>
      <span class="particle"></span>
    </div>
    
    <!-- Floating Orbs -->
    <div class="orb orb-gold w-[400px] h-[400px] top-0 left-0" style="animation-delay: 0s;"></div>
    <div class="orb orb-teal w-[500px] h-[500px] bottom-0 right-0" style="animation-delay: 2s;"></div>
    <div class="orb orb-gold w-[300px] h-[300px] top-1/2 right-1/4" style="animation-delay: 1s; opacity: 0.15;"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center animate-fade-in-up">
        <!-- Badge - Enhanced with glow -->
        <div class="inline-flex items-center gap-3 rounded-full px-6 py-3 mb-6" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.25) 0%, rgba(212, 164, 54, 0.1) 100%); border: 1px solid rgba(212, 164, 54, 0.4); box-shadow: 0 4px 30px rgba(212, 164, 54, 0.3), inset 0 1px 0 rgba(255,255,255,0.1);">
          <span class="w-3 h-3 rounded-full" style="background: #0d9488; box-shadow: 0 0 20px rgba(13, 148, 136, 0.8); animation: glow-pulse-strong 2s ease-in-out infinite;"></span>
          <span class="text-sm font-bold tracking-wide" style="color: #f5d76e;">Decentrathon 5.0 — AI inDrive Track</span>
        </div>
        
        <!-- Main headline - Reduced size -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-black mb-6 leading-none tracking-tighter">
          <span class="gradient-text-gold inline-block text-glow-gold" style="filter: drop-shadow(0 4px 30px rgba(212, 164, 54, 0.4));">66 млрд ₸</span>
          <br />
          <span class="text-white mt-4 block text-glow">неэффективно потрачено</span>
        </h1>
        
        <p class="text-lg md:text-xl max-w-3xl mx-auto mb-8 leading-relaxed text-force-light-muted">
          Данные Высшей аудиторской палаты о сельхозсубсидиях за 2022-2023 годы. 
          <strong class="text-white text-glow">AgroScore</strong> — AI-система для справедливого и эффективного распределения.
        </p>
        
        <!-- CTA Buttons - Premium with extra glow -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a href="/simulator" class="btn-premium btn-premium-gold w-full sm:w-auto text-lg px-10 py-5 shadow-glow-gold-strong">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Симулятор What-If
          </a>
          <a href="/precheck" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-10 py-5 rounded-xl text-lg font-semibold transition-all hover:scale-105 hover:shadow-glow-teal-strong" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); backdrop-filter: blur(20px);">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Pre-Check для фермера
          </a>
        </div>
        
        <!-- Stats bar - Premium with hover glow -->
        <div class="mt-12 pt-8 border-t border-white/15">
          <div class="grid grid-cols-3 gap-10 max-w-4xl mx-auto">
            <div class="text-center group cursor-default transition-all hover:scale-105">
              <div class="stat-dramatic gradient-text-gold group-hover:text-glow-gold transition-all">36,651</div>
              <div class="text-sm font-semibold mt-3 text-white/50 group-hover:text-white/70 transition-colors">заявок в датасете</div>
            </div>
            <div class="text-center group cursor-default transition-all hover:scale-105">
              <div class="stat-dramatic text-teal-300 group-hover:text-glow-teal transition-all">17</div>
              <div class="text-sm font-semibold mt-3 text-white/50 group-hover:text-white/70 transition-colors">областей Казахстана</div>
            </div>
            <div class="text-center group cursor-default transition-all hover:scale-105">
              <div class="stat-dramatic text-white group-hover:text-glow transition-all">2025</div>
              <div class="text-sm font-semibold mt-3 text-white/50 group-hover:text-white/70 transition-colors">актуальные данные</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Metrics - 3D Cards -->
  <section class="py-20" style="background: #fdfcfb;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 mb-4" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.1) 0%, rgba(13, 148, 136, 0.05) 100%); border: 1px solid rgba(13, 148, 136, 0.15);">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: #0d9488;">Ключевые показатели</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold" style="color: #1e3a5f;">Что мы обнаружили в данных</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <!-- Card 1 -->
        <div class="card-3d group p-6 hover:shadow-glow-navy-strong">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 icon-container" style="background: linear-gradient(135deg, rgba(30, 58, 95, 0.15) 0%, rgba(30, 58, 95, 0.05) 100%);">
            <svg class="w-7 h-7 text-navy-700 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <div class="text-4xl font-black gradient-text-navy">36,651</div>
          <div class="text-sm font-semibold mt-2" style="color: #627d98;">Заявок в датасете</div>
        </div>
        
        <!-- Card 2 -->
        <div class="card-3d group p-6 hover:shadow-glow-red-strong">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 icon-container" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.15) 0%, rgba(220, 38, 38, 0.05) 100%);">
            <svg class="w-7 h-7 text-red-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-4xl font-black" style="color: #dc2626;">9.2%</div>
          <div class="text-sm font-semibold mt-2" style="color: #627d98;">Отказов (заявки)</div>
          <div class="mt-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(220, 38, 38, 0.1); color: #991b1b;">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.293 7.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L10 4.414l-3.293 3.293a1 1 0 01-1.414 0z" clip-rule="evenodd" transform="rotate(180 10 10)" /></svg>
            Проблема
          </div>
        </div>
        
        <!-- Card 3 -->
        <div class="card-3d group p-6 hover:shadow-glow-teal-strong">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 icon-container" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.15) 0%, rgba(13, 148, 136, 0.05) 100%);">
            <svg class="w-7 h-7 text-teal-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-4xl font-black gradient-text-teal">3.7%</div>
          <div class="text-sm font-semibold mt-2" style="color: #627d98;">Отказов (кейсы)</div>
          <div class="text-xs mt-1" style="color: #0f766e;">После дедупликации</div>
        </div>
        
        <!-- Card 4 -->
        <div class="card-3d group p-6 hover:shadow-glow-gold-strong">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-4 icon-container" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.15) 0%, rgba(212, 164, 54, 0.05) 100%);">
            <svg class="w-7 h-7 text-amber-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <div class="text-4xl font-black gradient-text-gold">65%</div>
          <div class="text-sm font-semibold mt-2" style="color: #627d98;">Отказов = retry</div>
          <div class="mt-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold" style="background: rgba(212, 164, 54, 0.15); color: #a16207;">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
            Предупреждение
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Statement - 3D Cards with Glows -->
  <section class="py-24" style="background: linear-gradient(180deg, #fdfcfb 0%, #f5f5f4 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 mb-4" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.1) 0%, rgba(220, 38, 38, 0.05) 100%); border: 1px solid rgba(220, 38, 38, 0.15);">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: #dc2626;">Проблема</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-extrabold" style="color: #1e3a5f;">Три проблемы текущей системы</h2>
        <p class="mt-3 text-lg" style="color: #627d98;">Почему субсидии распределяются неэффективно</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Problem 1 - Red -->
        <div class="card-3d card-gradient-border group p-8 hover:shadow-glow-red-strong">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 icon-glow icon-glow-red icon-float" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.15) 0%, rgba(220, 38, 38, 0.05) 100%);">
            <svg class="w-10 h-10 text-red-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3" style="color: #1e3a5f;">FIFO-распределение</h3>
          <p class="leading-relaxed" style="color: #627d98;">
            Кто первый подал заявку — тот и получил субсидию. 
            <strong class="text-red-600">Нет оценки</strong> потенциального эффекта для экономики.
          </p>
        </div>
        
        <!-- Problem 2 - Orange -->
        <div class="card-3d card-gradient-border group p-8 hover:shadow-glow-gold-strong">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 icon-glow icon-glow-gold icon-float" style="background: linear-gradient(135deg, rgba(234, 88, 12, 0.15) 0%, rgba(234, 88, 12, 0.05) 100%); animation-delay: 0.5s;">
            <svg class="w-10 h-10 text-orange-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3" style="color: #1e3a5f;">65% отказов = retry</h3>
          <p class="leading-relaxed" style="color: #627d98;">
            Фермер не знает причину отказа до подачи. 
            Подаёт <strong class="text-orange-600">снова и снова</strong>, создавая нагрузку на систему.
          </p>
        </div>
        
        <!-- Problem 3 - Gold -->
        <div class="card-3d card-gradient-border group p-8 hover:shadow-glow-gold-strong">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mb-6 icon-glow icon-glow-gold icon-float" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.15) 0%, rgba(212, 164, 54, 0.05) 100%); animation-delay: 1s;">
            <svg class="w-10 h-10 text-amber-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-3" style="color: #1e3a5f;">Монополизация</h3>
          <p class="leading-relaxed" style="color: #627d98;">
            В Тюлькубасском районе <strong class="text-amber-600">86% бюджета</strong> ушло одному получателю. 
            Нет ограничений на концентрацию.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution - Enhanced -->
  <section class="py-24" style="background: linear-gradient(180deg, #f5e6c8 0%, #fdfcfb 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 mb-4" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.15) 0%, rgba(212, 164, 54, 0.08) 100%); border: 1px solid rgba(212, 164, 54, 0.2);">
          <span class="text-xs font-bold uppercase tracking-wider" style="color: #d4a436;">Наше решение</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-extrabold" style="color: #1e3a5f;">Три слоя Merit-based системы</h2>
        <p class="mt-4 text-lg" style="color: #627d98;">Вместо FIFO — прозрачное ранжирование по эффекту</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Layer 1: Pre-Check -->
        <div class="card-3d group p-8 hover:shadow-glow-teal-strong" style="border-top: 4px solid #0d9488;">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6 icon-container icon-float" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.15) 0%, rgba(13, 148, 136, 0.05) 100%);">
            <svg class="w-8 h-8 text-teal-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-xs font-bold uppercase tracking-wider mb-2" style="color: #0d9488;">Слой 1</div>
          <h3 class="text-2xl font-bold mb-3" style="color: #1e3a5f;">Pre-Check</h3>
          <p class="mb-6" style="color: #627d98;">Проверка заявки ДО подачи</p>
          <ul class="space-y-4 text-sm" style="color: #44403c;">
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 icon-pulse" style="background: rgba(13, 148, 136, 0.15);">
                <svg class="w-4 h-4" style="color: #0d9488;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              Мгновенная валидация
            </li>
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(13, 148, 136, 0.15);">
                <svg class="w-4 h-4" style="color: #0d9488;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              Понятные причины отказа
            </li>
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(13, 148, 136, 0.15);">
                <svg class="w-4 h-4" style="color: #0d9488;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              <span><strong class="text-xl gradient-text-teal">-77%</strong> retry заявок</span>
            </li>
          </ul>
        </div>
        
        <!-- Layer 2: Impact Score -->
        <div class="card-3d group p-8 hover:shadow-glow-navy-strong" style="border-top: 4px solid #1e3a5f;">
          <div class="w-16 h-16 rounded-2xl flex items-center justify-center mb-6 icon-container icon-float" style="background: linear-gradient(135deg, rgba(30, 58, 95, 0.15) 0%, rgba(30, 58, 95, 0.05) 100%); animation-delay: 0.5s;">
            <svg class="w-8 h-8 text-navy-700 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <div class="text-xs font-bold uppercase tracking-wider mb-2" style="color: #1e3a5f;">Слой 2</div>
          <h3 class="text-2xl font-bold mb-3" style="color: #1e3a5f;">Impact Score</h3>
          <p class="mb-6" style="color: #627d98;">Ранжирование по эффекту</p>
          <ul class="space-y-4 text-sm" style="color: #44403c;">
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(30, 58, 95, 0.15);">
                <svg class="w-4 h-4" style="color: #1e3a5f;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              6 компонентов оценки
            </li>
            <li class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0" style="background: rgba(30, 58, 95, 0.15);">
                <svg class="w-4 h-4" style="color: #1e3a5f;" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
              Прозрачная формула
            </li>
            <li class="flex items-center gap-3">
