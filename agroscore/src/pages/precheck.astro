---
import Layout from '../layouts/Layout.astro';
import PreCheckForm from '../components/islands/PreCheckForm';
---

<Layout title="Pre-Check">
  <div class="py-10 lg:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header - Premium -->
      <div class="text-center mb-12 animate-fade-in-up">
        <div class="inline-flex items-center gap-2 rounded-full px-5 py-2 mb-5" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.15) 0%, rgba(212, 164, 54, 0.05) 100%); border: 1px solid rgba(212, 164, 54, 0.2);">
          <svg class="w-4 h-4" style="color: #d4a436;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-sm font-semibold" style="color: #a16207;">Для фермеров</span>
        </div>
        <h1 class="text-4xl lg:text-5xl font-extrabold mb-4" style="color: #1e3a5f;">
          Pre-Check заявки
        </h1>
        <p class="text-lg max-w-2xl mx-auto leading-relaxed" style="color: #627d98;">
          Проверьте вашу заявку на субсидию <strong style="color: #1e3a5f;">ДО</strong> подачи. 
          Узнайте потенциальные проблемы и ваш примерный рейтинг среди других заявок.
        </p>
      </div>
      
      <!-- Pre-Check Form Island -->
      <PreCheckForm client:load />
      
      <!-- Benefits Section - 3D Cards with Floating Icons -->
      <div class="mt-20 grid md:grid-cols-3 gap-8">
        <div class="card-3d group text-center p-8 hover:shadow-glow-teal-strong" style="border-top: 4px solid #0d9488;">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 icon-glow icon-float" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.2) 0%, rgba(13, 148, 136, 0.05) 100%);">
            <svg class="w-10 h-10 text-teal-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3" style="color: #1e3a5f;">Мгновенный результат</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">Узнайте статус за секунды, не ждите дни на официальный ответ</p>
        </div>
        
        <div class="card-3d group text-center p-8 hover:shadow-glow-navy-strong" style="border-top: 4px solid #1e3a5f;">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 icon-glow icon-glow-navy icon-float" style="background: linear-gradient(135deg, rgba(30, 58, 95, 0.2) 0%, rgba(30, 58, 95, 0.05) 100%); animation-delay: 0.5s;">
            <svg class="w-10 h-10 text-navy-700 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3" style="color: #1e3a5f;">Понятные причины</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">Конкретные проблемы с пошаговой инструкцией по исправлению</p>
        </div>
        
        <div class="card-3d group text-center p-8 hover:shadow-glow-gold-strong" style="border-top: 4px solid #d4a436;">
          <div class="w-20 h-20 rounded-2xl flex items-center justify-center mx-auto mb-6 icon-glow icon-glow-gold icon-float" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.2) 0%, rgba(212, 164, 54, 0.05) 100%); animation-delay: 1s;">
            <svg class="w-10 h-10 text-amber-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-xl font-bold mb-3" style="color: #1e3a5f;">Рекомендации</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">Персональные советы как улучшить ваш рейтинг и шансы</p>
        </div>
      </div>
      
      <!-- FAQ - Enhanced with Hover Glows -->
      <div class="mt-24">
        <div class="text-center mb-12">
          <div class="inline-flex items-center gap-2 rounded-full px-4 py-2 mb-4" style="background: linear-gradient(135deg, rgba(30, 58, 95, 0.1) 0%, rgba(30, 58, 95, 0.05) 100%); border: 1px solid rgba(30, 58, 95, 0.15);">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: #1e3a5f;">FAQ</span>
          </div>
          <h2 class="text-3xl font-bold" style="color: #1e3a5f;">Часто задаваемые вопросы</h2>
          <p class="text-sm mt-3" style="color: #627d98;">Ответы на популярные вопросы о Pre-Check</p>
        </div>
        <div class="space-y-5">
          <div class="card-3d group rounded-2xl p-6 relative overflow-hidden hover:shadow-glow-teal-strong transition-all" style="border-left: 4px solid #0d9488;">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-teal-500 opacity-0 group-hover:opacity-100 transition-opacity" style="box-shadow: 0 0 15px rgba(13, 148, 136, 0.6);"></div>
            <h3 class="font-bold text-lg mb-3 group-hover:text-teal-700 transition-colors" style="color: #1e3a5f;">Как работает Pre-Check?</h3>
            <p class="text-sm leading-relaxed" style="color: #627d98;">
              Мы проверяем введённые данные по правилам из Приложения 2 к Правилам субсидирования 
              и оцениваем вашу заявку по 6 компонентам Impact Score. Результат носит рекомендательный характер.
            </p>
          </div>
          
          <div class="card-3d group rounded-2xl p-6 relative overflow-hidden hover:shadow-glow-navy-strong transition-all" style="border-left: 4px solid #1e3a5f;">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-navy-500 opacity-0 group-hover:opacity-100 transition-opacity" style="box-shadow: 0 0 15px rgba(30, 58, 95, 0.6);"></div>
            <h3 class="font-bold text-lg mb-3 group-hover:text-navy-800 transition-colors" style="color: #1e3a5f;">Это официальная проверка?</h3>
            <p class="text-sm leading-relaxed" style="color: #627d98;">
              Нет, Pre-Check — это демонстрационный симулятор для предварительной оценки. 
              Официальное решение принимает комиссия после подачи заявки через egov.kz.
            </p>
          </div>
          
          <div class="card-3d group rounded-2xl p-6 relative overflow-hidden hover:shadow-glow-gold-strong transition-all" style="border-left: 4px solid #d4a436;">
            <div class="absolute left-0 top-0 bottom-0 w-1 bg-amber-500 opacity-0 group-hover:opacity-100 transition-opacity" style="box-shadow: 0 0 15px rgba(212, 164, 54, 0.6);"></div>
            <h3 class="font-bold text-lg mb-3 group-hover:text-amber-700 transition-colors" style="color: #1e3a5f;">Почему мой рейтинг низкий?</h3>
            <p class="text-sm leading-relaxed" style="color: #627d98;">
              Рейтинг зависит от типа субсидии, региона, размера хозяйства и сезона подачи. 
              Смотрите раздел "Рекомендации" — там указаны конкретные шаги для улучшения позиции.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
