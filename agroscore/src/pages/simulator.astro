---
import Layout from '../layouts/Layout.astro';
import BudgetSimulator from '../components/islands/BudgetSimulator';
---

<Layout title="What-If Симулятор">
  <div class="py-10 lg:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header - Premium -->
      <div class="mb-10 animate-fade-in-up">
        <div class="inline-flex items-center gap-2 rounded-full px-5 py-2 mb-4" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.15) 0%, rgba(13, 148, 136, 0.05) 100%); border: 1px solid rgba(13, 148, 136, 0.2);">
          <span class="w-2 h-2 rounded-full animate-pulse" style="background: #0d9488;"></span>
          <span class="text-sm font-semibold" style="color: #0d9488;">Интерактивный инструмент</span>
        </div>
        <h1 class="text-4xl lg:text-5xl font-extrabold mb-3" style="color: #1e3a5f;">
          What-If Симулятор
        </h1>
        <p class="text-lg max-w-2xl" style="color: #627d98;">
          Сравните стратегии распределения бюджета и увидите, как изменится результат при переходе от FIFO к Merit-based
        </p>
      </div>
      
      <!-- Simulator Island -->
      <BudgetSimulator client:load />
      
      <!-- Info Section - Premium Cards -->
      <div class="mt-16 grid md:grid-cols-3 gap-6">
        <div class="card-premium rounded-2xl p-8 hover-lift" style="border-left: 4px solid #1e3a5f;">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background: linear-gradient(135deg, rgba(30, 58, 95, 0.15) 0%, rgba(30, 58, 95, 0.05) 100%);">
            <svg class="w-7 h-7" style="color: #1e3a5f;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: #1e3a5f;">FIFO</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">
            Текущая система: кто первый подал заявку — тот и получил субсидию. 
            Нет оценки потенциального эффекта на экономику.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg" style="background: rgba(220, 38, 38, 0.08);">
            <span class="w-1.5 h-1.5 rounded-full" style="background: #dc2626;"></span>
            <span class="text-xs font-semibold" style="color: #991b1b;">Неоптимально</span>
          </div>
        </div>
        
        <div class="card-premium rounded-2xl p-8 hover-lift card-glow-teal" style="border-left: 4px solid #0d9488;">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background: linear-gradient(135deg, rgba(13, 148, 136, 0.2) 0%, rgba(13, 148, 136, 0.05) 100%);">
            <svg class="w-7 h-7" style="color: #0d9488;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: #0d9488;">Merit-based</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">
            Наше предложение: ранжирование по Impact Score. 
            Учёт эффекта, справедливости и региональных потребностей.
          </p>
          <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg" style="background: rgba(13, 148, 136, 0.1);">
            <span class="w-1.5 h-1.5 rounded-full" style="background: #0d9488;"></span>
            <span class="text-xs font-semibold" style="color: #0f766e;">Рекомендуем</span>
          </div>
        </div>
        
        <div class="card-premium rounded-2xl p-8 hover-lift" style="border-left: 4px solid #d4a436;">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.2) 0%, rgba(212, 164, 54, 0.05) 100%);">
            <svg class="w-7 h-7" style="color: #d4a436;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="text-lg font-bold mb-2" style="color: #1e3a5f;">Uplift</h3>
          <p class="text-sm leading-relaxed" style="color: #627d98;">
            Оптимум: максимизация эффекта на каждый тенге субсидии. 
            Учёт каузального воздействия (causal ML).
          </p>
          <div class="mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg" style="background: rgba(212, 164, 54, 0.1);">
            <span class="w-1.5 h-1.5 rounded-full" style="background: #d4a436;"></span>
            <span class="text-xs font-semibold" style="color: #a16207;">Coming Soon</span>
          </div>
        </div>
      </div>
      
      <!-- Disclaimer - Premium -->
      <div class="mt-12 glass-card rounded-2xl p-6" style="border-left: 4px solid #d4a436;">
        <div class="flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style="background: linear-gradient(135deg, rgba(212, 164, 54, 0.2) 0%, rgba(212, 164, 54, 0.1) 100%);">
            <svg class="w-5 h-5" style="color: #a16207;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div>
            <h4 class="font-bold" style="color: #854d0e;">Disclaimer</h4>
            <p class="text-sm mt-1 leading-relaxed" style="color: #a16207;">
              Это демонстрационный симулятор для хакатона, не production система. 
              Веса не калиброваны на реальных данных. Результаты демонстрируют концептуальное направление, а не точные прогнозы.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
