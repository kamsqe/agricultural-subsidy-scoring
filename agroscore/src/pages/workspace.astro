---
import WorkspaceComponent from '../components/Workspace';
import '../styles/global.css';
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>AgroScore B2G Workspace</title>
	</head>
	<body class="bg-slate-950 text-slate-100 min-h-screen m-0 p-0 overflow-x-hidden">
		<!-- Mobile blocker -->
		<div class="fixed inset-0 z-[9999] bg-slate-950 flex items-center justify-center p-8 lg:hidden">
			<div class="text-center max-w-sm">
				<div class="text-5xl mb-6">🖥️</div>
				<h2 class="text-2xl font-bold text-white mb-3">Переключитесь на десктоп</h2>
				<p class="text-slate-400 text-sm leading-relaxed">AgroScore — профессиональный B2G-терминал для работы с 36,000+ заявками. Для корректного отображения аналитики и таблиц требуется экран шириной от 1024px.</p>
				<div class="mt-6 px-4 py-2 bg-slate-800 border border-slate-700 rounded-lg text-xs text-slate-500 inline-block">min-width: 1024px</div>
			</div>
		</div>
		<WorkspaceComponent client:load />
	</body>
</html>
